{
  "name": "sheet-grid-spike",
  "private": true,
  "version": "0.0.0",
  "description": "FA0: grid candidates, canonical grid JSON and PostgreSQL measurements. Throwaway; not part of the platform build.",
  "type": "module",
  "scripts": {
    "tokens": "node scripts/copy-tokens.mjs",
    "prebuild": "node scripts/copy-tokens.mjs",
    "predev": "node scripts/copy-tokens.mjs",
    "dev": "next dev -p 3100",
    "build": "next build",
    "probe": "node probe.mjs",
    "spike": "node run-spike.mjs",
    "phone": "node phone-check.mjs",
    "ssr": "node ssr-check.mjs",
    "corpus": "node schema/run-corpus.mjs",
