    "pg": "node pg/measure.mjs"
  },
  "dependencies": {
    "@fortune-sheet/react": "1.0.4",
    "@tanstack/react-virtual": "3.14.21",
    "@univerjs/preset-sheets-core": "1.1.0",
    "@univerjs/presets": "1.1.0",
    "jspreadsheet-ce": "5.0.4",
    "next": "16.3.8",
    "react": "19.3.0",
    "react-dom": "19.3.0"
  },
  "devDependencies": {
    "ajv": "8.17.1",
    "pg": "8.13.1",
    "playwright-core": "1.55.0"
  }
