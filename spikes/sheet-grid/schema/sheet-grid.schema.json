{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "sheet-grid.schema.json",
  "title": "Canonical grid, format 1",
  "description": "The grid body of one template version. Structure only: ids that must be unique, cells that must point at a real row and column, merges that must not overlap, values that must fit the column type are checked by the validator next to this file (a schema cannot say them).",
  "type": "object",
  "additionalProperties": false,
  "required": ["formatVersion", "dimension", "rowsMode", "columns", "rows", "cells", "merges"],
  "properties": {
    "formatVersion": { "const": 1 },
    "dimension": { "enum": [1, 2] },
    "rowsMode": { "enum": ["FIXED", "REPEATABLE", "FIXED_AND_REPEATABLE"] },
    "columns": {
      "type": "array",
      "minItems": 1,
      "maxItems": 100,
      "items": { "$ref": "#/$defs/column" }
    },
    "headerRows": {
      "type": "array",
      "maxItems": 10,
      "items": { "$ref": "#/$defs/rowDefinition" }
    },
    "rows": {
      "type": "array",
      "maxItems": 500,
      "items": { "$ref": "#/$defs/rowDefinition" }
    },
    "cells": {
      "type": "object",
      "maxProperties": 50000,
      "propertyNames": { "pattern": "^[A-Za-z0-9_-]{1,40}:[A-Za-z0-9_-]{1,40}$" },
      "additionalProperties": { "$ref": "#/$defs/cell" }
    },
    "merges": {
      "type": "array",
      "maxItems": 2000,
      "items": { "$ref": "#/$defs/merge" }
    }
  },
  "$defs": {
    "id": { "type": "string", "pattern": "^[A-Za-z0-9_-]{1,40}$" },
    "cellRef": { "type": "string", "pattern": "^[A-Za-z0-9_-]{1,40}:[A-Za-z0-9_-]{1,40}$" },
    "label": { "type": "string", "minLength": 0, "maxLength": 200 },
    "column": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "label", "type"],
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "label": { "$ref": "#/$defs/label" },
        "type": { "enum": ["text", "number", "date", "picklist", "boolean"] },
        "required": { "type": "boolean" },
        "default": { "type": ["string", "boolean", "null"], "maxLength": 1000 },
        "picklist": {
          "type": ["object", "null"],
          "additionalProperties": false,
          "required": ["values"],
          "properties": {
            "values": {
              "type": "array",
              "minItems": 1,
              "maxItems": 100,
              "items": { "type": "string", "minLength": 1, "maxLength": 100 }
            }
          }
        },
        "width": { "type": "integer", "minimum": 40, "maximum": 1000 }
      }
    },
    "rowDefinition": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id"],
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "label": { "$ref": "#/$defs/label" },
        "height": { "type": "integer", "minimum": 16, "maximum": 400 }
      }
    },
    "cell": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "value": { "type": ["string", "boolean", "null"], "maxLength": 1000 },
        "style": {
          "type": "object",
          "additionalProperties": false,
          "properties": { "bold": { "type": "boolean" }, "italic": { "type": "boolean" } }
        },
        "kind": { "enum": ["fixed", "input"] }
      }
    },
    "merge": {
      "type": "object",
      "additionalProperties": false,
      "required": ["from", "to"],
      "properties": { "from": { "$ref": "#/$defs/cellRef" }, "to": { "$ref": "#/$defs/cellRef" } }
    }
  }
}
