# The rehearsal's ingress: it stands in for the load balancer of a real environment and must behave the way that one behaves
# (docs/runbooks/ingress.md, ADR-0286). The REAL rules (body sizes, time limits, the one honest X-Forwarded-For) are those of
# deploy/edge/api-rules.caddy, run by the edge sidecar beside every application replica, exactly as in a deployment. This file
# only does what the load balancer does:
#
#   - It keeps the ORIGINAL host name (the host is the tenant): the Host header is passed on as it came.
#   - http is sent to https; https answers with HSTS; one wildcard certificate (the rehearsal's own authority) covers the
#     platform domain and every organization under it.
#   - /api goes to the application replicas (their sidecars, port 8080), everything else to the web replicas, on one host.
#   - The management port (8081) is never routed and /actuator is answered 404 here too.
#   - A replica is a SLOT (backend-1 to backend-8, web-1 to web-8): the scripts give a replica the name of a free slot. The
#     ingress checks every slot every second (the application's own readiness, through its sidecar) and sends requests only
#     to a slot that passes, like a balancer that registers a target only when it is healthy and takes it out when it fails.
#     A slot with no replica is simply unhealthy. A request is NOT retried (a cloud load balancer does not retry), so whatever a
#     release does wrong shows up as a failed request and is not hidden here.
#   - Like a cloud balancer, it APPENDS the caller's address to X-Forwarded-For (trusting what arrives, as a balancer that has
#     nothing in front of it would have to), and it does not touch an X-Forwarded-Host the caller sent.
{
	servers {
		trusted_proxies static 0.0.0.0/0 ::/0
	}
}

{$BASE_DOMAIN}, *.{$BASE_DOMAIN} {
	tls internal
	encode zstd gzip

	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		-Server
	}

	@management path /actuator /actuator/*
	respond @management 404

	@api path /api/*
	handle @api {
		reverse_proxy backend-1:8080 backend-2:8080 backend-3:8080 backend-4:8080 backend-5:8080 backend-6:8080 backend-7:8080 backend-8:8080 {
			lb_policy least_conn
			health_uri /edge-ready
			health_interval 1s
			health_timeout 1s
			health_status 200
			health_passes 2
			health_fails 1
			transport http {
				dial_timeout 2s
				response_header_timeout 130s
			}
		}
	}

	handle {
		reverse_proxy web-1:3000 web-2:3000 web-3:3000 web-4:3000 web-5:3000 web-6:3000 web-7:3000 web-8:3000 {
			lb_policy least_conn
			health_uri /healthz
			health_interval 1s
			health_timeout 1s
			health_status 200
			health_passes 2
			health_fails 1
			transport http {
				dial_timeout 2s
				response_header_timeout 30s
			}
		}
	}
}
