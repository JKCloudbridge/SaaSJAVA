# Template for infra/local/.env. Do not put real credentials here.
# Create the real file with:  ./init-env.ps1   (generates random local-only values)
POSTGRES_USER=platform
POSTGRES_PASSWORD=change-me
POSTGRES_DB=platform
POSTGRES_PORT=5432

REDIS_PASSWORD=change-me
REDIS_PORT=6379

S3_ACCESS_KEY=change-me
S3_SECRET_KEY=change-me
S3_PORT=8333

MAIL_SMTP_PORT=1025
MAIL_UI_PORT=8025

# Trace viewer: the collector port (what the browser app and the API export traces to) and the web UI.
TRACING_COLLECTOR_PORT=4318
TRACING_UI_PORT=16686

# Optional: log every SQL statement in the database log (0) instead of only slow ones (default 500 ms).
# POSTGRES_LOG_MIN_DURATION_MS=0

# The application's own database role (created by manual migration M001; see init-app-role.ps1). The application connects
# as this role, never as POSTGRES_USER, which owns the schema and runs the migrations. The name must stay platform_app.
APP_DB_USER=platform_app
APP_DB_PASSWORD=change-me
