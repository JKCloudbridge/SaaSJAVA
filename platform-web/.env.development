# Defaults for `npm run dev`. Non-secret on purpose: nothing sensitive belongs in a frontend project, because
# everything prefixed NEXT_PUBLIC_ is shipped to the browser.
#
# Where the platform API listens (the browser never sees this; Next.js forwards /api to it).
PLATFORM_API_ORIGIN=http://localhost:8080
# The local trace viewer (infra/local, service "tracing"). Browser spans go to /telemetry on this app's own origin.
PLATFORM_TRACE_COLLECTOR_ORIGIN=http://localhost:4318
NEXT_PUBLIC_TRACE_EXPORT=true
