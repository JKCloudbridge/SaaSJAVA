{
  "name": "platform-web",
  "version": "0.1.0",
  "private": true,
  "description": "Web frontend of the platform. Presentation and interaction only: the backend is authoritative for validation, permissions and business rules.",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "api:generate": "node scripts/api-client.mjs",
    "api:check": "node scripts/api-client.mjs --check",
    "verify": "npm run lint && npm run typecheck && npm run test && npm run api:check && npm run build"
  },
  "dependencies": {
    "@opentelemetry/api": "1.9.1",
    "@opentelemetry/core": "2.11.0",
    "@opentelemetry/exporter-trace-otlp-http": "0.222.0",
    "@opentelemetry/instrumentation": "0.222.0",
    "@opentelemetry/instrumentation-fetch": "0.222.0",
    "@opentelemetry/resources": "2.11.0",
    "@opentelemetry/sdk-trace-base": "2.11.0",
    "@opentelemetry/sdk-trace-web": "2.11.0",
    "@opentelemetry/semantic-conventions": "1.43.0",
    "next": "16.3.8",
    "openapi-fetch": "0.17.0",
    "react": "19.3.0",
    "react-dom": "19.3.0"
  },
  "devDependencies": {
    "@testing-library/dom": "10.4.2",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.3",
    "@types/node": "24.19.0",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.1",
    "eslint": "9.39.5",
    "eslint-config-next": "16.3.8",
    "jsdom": "26.1.0",
    "openapi-typescript": "7.13.0",
    "typescript": "7.0.2",
    "vite": "8.3.1",
    "vitest": "5.0.3"
  }
}
