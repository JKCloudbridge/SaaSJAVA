{
  "name": "platform-web",
  "version": "0.1.0",
  "private": true,
  "description": "Web frontend of the platform. Presentation and interaction only: the backend is authoritative for validation, permissions and business rules.",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "api:generate": "node scripts/api-client.mjs",
    "api:check": "node scripts/api-client.mjs --check",
    "api:public:check": "node contract-checks/public-api/check.mjs",
    "verify": "npm run lint && npm run typecheck && npm run test && npm run api:check && npm run api:public:check && npm run build"
  },
  "dependencies": {
    "@opentelemetry/api": "1.10.0",
    "@opentelemetry/core": "3.1.1",
    "@opentelemetry/exporter-trace-otlp-http": "0.301.2",
    "@opentelemetry/instrumentation": "0.301.2",
    "@opentelemetry/instrumentation-fetch": "0.301.2",
    "@opentelemetry/resources": "3.1.1",
    "@opentelemetry/sdk-trace-base": "2.12.0",
    "@opentelemetry/sdk-trace-web": "2.12.0",
    "@opentelemetry/semantic-conventions": "1.45.0",
    "@tanstack/react-virtual": "3.14.21",
    "next": "16.4.6",
    "openapi-fetch": "0.17.0",
    "react": "19.3.0",
    "react-dom": "19.3.0"
  },
  "devDependencies": {
    "@testing-library/dom": "10.4.2",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.3",
    "@types/node": "24.19.0",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.1",
    "eslint": "9.39.5",
    "eslint-config-next": "16.4.6",
    "jsdom": "26.1.0",
    "openapi-typescript": "7.13.0",
    "typescript": "5.9.3",
    "vite": "8.3.1",
    "vitest": "5.0.3"
  }
}
