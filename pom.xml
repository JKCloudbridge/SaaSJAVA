<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <!-- Parent POM and dependency BOM for the whole platform (decision D1, ADR-0004).
       Spring Boot's starter parent supplies plugin management; the Spring Modulith BOM is
       imported below. Every version used by a module is declared here, never in a child. -->
  <parent>
    <groupId>org.springframework.boot</groupId>
    <artifactId>spring-boot-starter-parent</artifactId>
    <version>4.1.2</version>
    <relativePath/>
  </parent>

  <groupId>app.platform</groupId>
  <artifactId>platform-parent</artifactId>
  <version>0.1.0-SNAPSHOT</version>
  <packaging>pom</packaging>
  <name>platform-parent</name>
  <description>Multi-tenant metadata-driven application platform: parent POM and dependency BOM</description>

  <modules>
    <module>platform-shared-kernel</module>
    <module>platform-api-contract</module>
    <module>platform-app</module>
  </modules>

  <properties>
    <java.version>25</java.version>
    <maven.compiler.release>25</maven.compiler.release>
    <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
    <project.build.outputTimestamp>2026-01-01T00:00:00Z</project.build.outputTimestamp>

    <!-- Security overrides of versions managed by Spring Boot 4.1.1 (found by the container scan on 2026-10-01).
         Remove each override as soon as the Spring Boot BOM ships the same or a newer version. -->
    <tomcat.version>11.0.26</tomcat.version>
    <jackson-bom.version>3.1.7</jackson-bom.version>
    <!-- Sprint 1: the OpenAPI generator brings the previous Jackson line (2.x). The scan of the built jar found three
         fixable HIGH issues in 2.21.5 (databind: unbounded numeric parsing, two deserializer flaws), fixed in 2.21.7. -->
    <jackson-2-bom.version>2.21.7</jackson-2-bom.version>

    <!-- Versions not managed by the Spring Boot BOM. -->
    <spring-modulith.version>2.1.2</spring-modulith.version>
    <archunit.version>1.5.1</archunit.version>
    <!-- Sprint 7: property-based tests of the effective-permission calculator (test scope only, never shipped). -->
    <jqwik.version>1.10.1</jqwik.version>
    <springdoc.version>3.1.1</springdoc.version>
    <datasource-micrometer.version>2.3.0</datasource-micrometer.version>
    <!-- Sprint 3: the cryptography library behind the Argon2id password hash (Spring's encoder needs it; the JDK has none). -->
    <bouncycastle.version>1.86</bouncycastle.version>
    <!-- Sprint 12: validates page layouts, record pages and applications against their JSON schema (ADR-0070). -->
    <json-schema-validator.version>3.0.8</json-schema-validator.version>
    <!-- Sprint 17: the client of the S3-compatible object storage that holds the bytes of files (ADR-0120). -->
    <awssdk.version>2.55.5</awssdk.version>
    <!-- Sprint 29A: the SSH client behind file transfer (ADR-0238). A single jar with no further dependency, BSD licence.
         2.28.6 and later carry the fix for the known-hosts parsing flaw (reported September 2026); the platform does not
         use that code anyway, the host key is pinned in the connection. -->
    <ssh-client.version>2.28.8</ssh-client.version>
    <!-- Sprint 29A: a small in-process SSH and file transfer server, test scope only, so tests meet a real server. -->
    <ssh-test-server.version>2.20.1</ssh-test-server.version>
    <!-- SH1B: the library that reads the styles of an uploaded workbook (ADR-0253). Only poi, poi-ooxml and poi-ooxml-lite
         are used: never the scratchpad module and never the full schema bundle. Apache 2.0; named by the sheets module
         only (an architecture test). 6.0.0 has no open advisory at the time of writing (the zip-part flaw of the 5.x
         line is fixed from 5.4.0). -->
    <poi.version>6.0.0</poi.version>
    <commons-io.version>2.22.0</commons-io.version>

    <!-- Build plugin versions. -->
    <maven-enforcer-plugin.version>3.6.3</maven-enforcer-plugin.version>
    <maven-checkstyle-plugin.version>3.6.0</maven-checkstyle-plugin.version>
    <checkstyle.version>14.3.0</checkstyle.version>
    <spotbugs-maven-plugin.version>4.10.4.1</spotbugs-maven-plugin.version>
    <jacoco-maven-plugin.version>0.8.15</jacoco-maven-plugin.version>

    <!-- Minimum toolchain, enforced below. -->
    <enforcer.java.range>[25,)</enforcer.java.range>
    <enforcer.maven.range>[3.9.9,)</enforcer.maven.range>
  </properties>

  <dependencyManagement>
    <dependencies>
      <dependency>
        <!-- The client of the S3-compatible object storage (ADR-0120); the bill of materials keeps its parts on one version. -->
        <groupId>software.amazon.awssdk</groupId>
        <artifactId>bom</artifactId>
        <version>${awssdk.version}</version>
        <type>pom</type>
        <scope>import</scope>
      </dependency>
      <dependency>
        <groupId>org.springframework.modulith</groupId>
        <artifactId>spring-modulith-bom</artifactId>
        <version>${spring-modulith.version}</version>
        <type>pom</type>
        <scope>import</scope>
      </dependency>
      <dependency>
        <groupId>com.tngtech.archunit</groupId>
        <artifactId>archunit</artifactId>
        <version>${archunit.version}</version>
      </dependency>
      <dependency>
        <!-- Property-based tests (a test engine that tries many random inputs); test scope only. -->
        <groupId>net.jqwik</groupId>
        <artifactId>jqwik</artifactId>
        <version>${jqwik.version}</version>
      </dependency>
      <dependency>
        <!-- Generates the OpenAPI document from the controllers (ADR-0011). -->
        <groupId>org.springdoc</groupId>
        <artifactId>springdoc-openapi-starter-webmvc-api</artifactId>
        <version>${springdoc.version}</version>
      </dependency>
      <dependency>
        <!-- Checks a definition against the JSON schema of its kind and names the place that is wrong (ADR-0070). It is
             built on the same Jackson line as the application (3.x); it brings no other runtime library. -->
        <groupId>com.networknt</groupId>
        <artifactId>json-schema-validator</artifactId>
        <version>${json-schema-validator.version}</version>
      </dependency>
      <dependency>
        <!-- One span per SQL statement, so a trace reaches the database (ADR-0012). -->
        <groupId>net.ttddyy.observation</groupId>
        <artifactId>datasource-micrometer-spring-boot</artifactId>
        <version>${datasource-micrometer.version}</version>
      </dependency>

      <dependency>
        <groupId>org.bouncycastle</groupId>
        <artifactId>bcprov-jdk18on</artifactId>
        <version>${bouncycastle.version}</version>
      </dependency>
      <dependency>
        <!-- File transfer over SSH (ADR-0238); used by one class of the integration module. -->
        <groupId>com.github.mwiede</groupId>
        <artifactId>jsch</artifactId>
        <version>${ssh-client.version}</version>
      </dependency>
      <dependency>
        <!-- Reads the styles, colours and number formats of a workbook, from bytes, behind the guards of the sheets
             module (ADR-0253). The full schema bundle and the scratchpad module are deliberately not used. -->
        <groupId>org.apache.poi</groupId>
        <artifactId>poi-ooxml</artifactId>
        <version>${poi.version}</version>
      </dependency>
      <dependency>
        <groupId>org.apache.poi</groupId>
        <artifactId>poi-ooxml-lite</artifactId>
        <version>${poi.version}</version>
      </dependency>
      <dependency>
        <!-- The library and its archive helper ask for different patch versions of this one; the newer is chosen so the
             build's convergence rule holds (SH1B). -->
        <groupId>commons-io</groupId>
        <artifactId>commons-io</artifactId>
        <version>${commons-io.version}</version>
      </dependency>
      <dependency>
        <groupId>org.apache.sshd</groupId>
        <artifactId>sshd-core</artifactId>
        <version>${ssh-test-server.version}</version>
      </dependency>
      <dependency>
        <groupId>org.apache.sshd</groupId>
        <artifactId>sshd-sftp</artifactId>
        <version>${ssh-test-server.version}</version>
      </dependency>

      <!-- Platform modules. -->
      <dependency>
        <groupId>app.platform</groupId>
        <artifactId>platform-shared-kernel</artifactId>
        <version>${project.version}</version>
      </dependency>
      <dependency>
        <groupId>app.platform</groupId>
        <artifactId>platform-api-contract</artifactId>
        <version>${project.version}</version>
      </dependency>
    </dependencies>
  </dependencyManagement>

  <build>
    <pluginManagement>
      <plugins>
        <plugin>
          <groupId>org.apache.maven.plugins</groupId>
          <artifactId>maven-enforcer-plugin</artifactId>
          <version>${maven-enforcer-plugin.version}</version>
        </plugin>
        <plugin>
          <!-- Pinned only so the requirePluginVersions rule is satisfied for pom-packaged projects. -->
          <groupId>org.apache.maven.plugins</groupId>
          <artifactId>maven-site-plugin</artifactId>
          <version>3.22.0</version>
        </plugin>
        <plugin>
          <!-- Tests always run in UTC: deterministic across machines, and PostgreSQL rejects some legacy zone aliases the JVM may report.
               The mock library is loaded as a Java agent instead of attaching itself at run time, which a future JDK will no longer
               allow (the library's own advice). The jar is the one the test dependencies already resolved into the local repository. -->
          <groupId>org.apache.maven.plugins</groupId>
          <artifactId>maven-surefire-plugin</artifactId>
          <configuration>
            <argLine>-Duser.timezone=UTC -Djdk.httpclient.allowRestrictedHeaders=host -javaagent:${settings.localRepository}/org/mockito/mockito-core/${mockito.version}/mockito-core-${mockito.version}.jar</argLine>
          </configuration>
        </plugin>
        <plugin>
          <groupId>org.apache.maven.plugins</groupId>
          <artifactId>maven-failsafe-plugin</artifactId>
          <configuration>
            <!-- The integration tests share one JVM and keep many application contexts and second instances alive; the
                 default heap (a quarter of the machine) ran out late in the run and failed unrelated tests. -->
            <argLine>-Xmx3g -Duser.timezone=UTC -Djdk.httpclient.allowRestrictedHeaders=host -javaagent:${settings.localRepository}/org/mockito/mockito-core/${mockito.version}/mockito-core-${mockito.version}.jar</argLine>
          </configuration>
        </plugin>
        <plugin>
          <groupId>org.apache.maven.plugins</groupId>
          <artifactId>maven-checkstyle-plugin</artifactId>
          <version>${maven-checkstyle-plugin.version}</version>
          <dependencies>
            <dependency>
              <groupId>com.puppycrawl.tools</groupId>
              <artifactId>checkstyle</artifactId>
              <version>${checkstyle.version}</version>
            </dependency>
          </dependencies>
        </plugin>
        <plugin>
          <groupId>com.github.spotbugs</groupId>
          <artifactId>spotbugs-maven-plugin</artifactId>
          <version>${spotbugs-maven-plugin.version}</version>
        </plugin>
        <plugin>
          <groupId>org.jacoco</groupId>
          <artifactId>jacoco-maven-plugin</artifactId>
          <version>${jacoco-maven-plugin.version}</version>
        </plugin>
      </plugins>
    </pluginManagement>

    <plugins>
      <!-- Enforcer rules: toolchain, dependency hygiene, banned legacy libraries. -->
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-enforcer-plugin</artifactId>
        <executions>
          <execution>
            <id>enforce-platform-rules</id>
            <phase>validate</phase>
            <goals>
              <goal>enforce</goal>
            </goals>
            <configuration>
              <fail>true</fail>
              <rules>
                <requireJavaVersion>
                  <version>${enforcer.java.range}</version>
                  <message>Java 25 or newer is required to build this project.</message>
                </requireJavaVersion>
                <requireMavenVersion>
                  <version>${enforcer.maven.range}</version>
                </requireMavenVersion>
                <requirePluginVersions>
                  <banLatest>true</banLatest>
                  <banRelease>true</banRelease>
                  <banSnapshots>true</banSnapshots>
                </requirePluginVersions>
                <banDuplicatePomDependencyVersions/>
                <dependencyConvergence/>
                <bannedDependencies>
                  <searchTransitive>true</searchTransitive>
                  <excludes>
                    <exclude>log4j:log4j</exclude>
                    <exclude>org.apache.logging.log4j:log4j-core</exclude>
                    <exclude>javax.servlet:*</exclude>
                    <exclude>javax.persistence:*</exclude>
                    <exclude>javax.validation:*</exclude>
                    <exclude>javax.annotation:*</exclude>
                    <exclude>org.springframework.boot:spring-boot-starter-logging-log4j2</exclude>
                  </excludes>
                  <message>Banned legacy or conflicting dependency.</message>
                </bannedDependencies>
              </rules>
            </configuration>
          </execution>
        </executions>
      </plugin>

      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-compiler-plugin</artifactId>
        <configuration>
          <release>${maven.compiler.release}</release>
          <parameters>true</parameters>
          <showWarnings>true</showWarnings>
          <compilerArgs>
            <arg>-Xlint:all,-processing,-serial</arg>
            <arg>-Werror</arg>
          </compilerArgs>
        </configuration>
      </plugin>
    </plugins>
  </build>

  <profiles>
    <!-- Runs only the integration tests (failsafe): skips the unit-test plugin, still builds and packages. -->
    <profile>
      <id>integration-only</id>
      <build>
        <plugins>
          <plugin>
            <groupId>org.apache.maven.plugins</groupId>
            <artifactId>maven-surefire-plugin</artifactId>
            <configuration>
              <skip>true</skip>
            </configuration>
          </plugin>
        </plugins>
      </build>
    </profile>

    <!-- Static analysis: run in CI (`-Pquality`) and locally before a PR. -->
    <profile>
      <id>quality</id>
      <build>
        <plugins>
          <plugin>
            <groupId>org.apache.maven.plugins</groupId>
            <artifactId>maven-checkstyle-plugin</artifactId>
            <executions>
              <execution>
                <id>checkstyle</id>
                <phase>verify</phase>
                <goals>
                  <goal>check</goal>
                </goals>
                <configuration>
                  <configLocation>${maven.multiModuleProjectDirectory}/config/checkstyle.xml</configLocation>
                  <suppressionsLocation>${maven.multiModuleProjectDirectory}/config/checkstyle-suppressions.xml</suppressionsLocation>
                  <includeTestSourceDirectory>true</includeTestSourceDirectory>
                  <consoleOutput>true</consoleOutput>
                  <failOnViolation>true</failOnViolation>
                  <violationSeverity>warning</violationSeverity>
                </configuration>
              </execution>
            </executions>
          </plugin>
          <plugin>
            <groupId>com.github.spotbugs</groupId>
            <artifactId>spotbugs-maven-plugin</artifactId>
            <configuration>
              <effort>Max</effort>
              <threshold>Medium</threshold>
              <failOnError>true</failOnError>
              <excludeFilterFile>${maven.multiModuleProjectDirectory}/config/spotbugs-exclude.xml</excludeFilterFile>
            </configuration>
            <executions>
              <execution>
                <id>spotbugs</id>
                <phase>verify</phase>
                <goals>
                  <goal>check</goal>
                </goals>
              </execution>
            </executions>
          </plugin>
        </plugins>
      </build>
    </profile>
  </profiles>
</project>
