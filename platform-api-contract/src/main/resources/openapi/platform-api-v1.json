{
  "openapi" : "3.1.0",
  "info" : {
    "description" : "HTTP API of the multi-tenant application platform. Every successful body is {\"data\": ...} (collections add \"pagination\"); every failure is {\"error\": {code, message, fields?, requestId, traceId?}}.",
    "title" : "Platform API",
    "version" : "v1"
  },
  "servers" : [ {
    "url" : "/"
  } ],
  "paths" : {
    "/api/v1/auth/csrf" : {
      "get" : {
        "description" : "Answers 204 and sets the XSRF-TOKEN cookie. A browser page reads that cookie and sends its value in the X-XSRF-TOKEN header with every state-changing request, which the server compares with the cookie.",
        "operationId" : "getCsrfToken",
        "responses" : {
          "200" : {
            "description" : "OK"
          },
          "default" : {
            "content" : {
              "application/json" : {
                "schema" : {
                  "$ref" : "#/components/schemas/ApiErrorResponse"
                }
              }
            },
            "description" : "Error. The code says what went wrong; the message is safe to show."
          }
        },
        "summary" : "Receive the forgery-protection cookie",
        "tags" : [ "Authentication" ]
      }
    },
    "/api/v1/auth/me" : {
      "get" : {
        "description" : "The signed-in user. 401 UNAUTHENTICATED without a valid token. Says nothing about what the user may do: permissions are decided elsewhere, per organization.",
        "operationId" : "getCurrentUser",
        "responses" : {
          "200" : {
            "content" : {
              "application/json" : {
                "schema" : {
                  "$ref" : "#/components/schemas/ApiResponseCurrentUser"
                }
              }
            },
            "description" : "OK"
          },
          "default" : {
            "content" : {
              "application/json" : {
                "schema" : {
                  "$ref" : "#/components/schemas/ApiErrorResponse"
                }
              }
            },
            "description" : "Error. The code says what went wrong; the message is safe to show."
          }
        },
        "summary" : "Who the caller is",
        "tags" : [ "Authentication" ]
      }
    },
    "/api/v1/auth/password" : {
      "post" : {
        "description" : "Needs the current password and a new one that meets the password policy. Ends every session of the user, including this one: sign in again afterwards.",
        "operationId" : "changePassword",
        "requestBody" : {
          "content" : {
            "application/json" : {
              "schema" : {
                "$ref" : "#/components/schemas/ChangePasswordRequest"
              }
            }
          },
          "required" : true
        },
        "responses" : {
          "200" : {
            "description" : "OK"
          },
          "default" : {
            "content" : {
              "application/json" : {
                "schema" : {
                  "$ref" : "#/components/schemas/ApiErrorResponse"
                }
              }
            },
            "description" : "Error. The code says what went wrong; the message is safe to show."
          }
        },
        "summary" : "Change the password of the signed-in user",
        "tags" : [ "Authentication" ]
      }
    },
    "/api/v1/auth/password/forgot" : {
      "post" : {
        "description" : "Always answers 202 with the same text, whether or not the address has an account: if it has an active one, an e-mail with a link follows. Only on the platform host. A locked account can be reset. Too many requests answer 429 RATE_LIMITED.",
        "operationId" : "requestPasswordReset",
        "requestBody" : {
          "content" : {
            "application/json" : {
              "schema" : {
                "$ref" : "#/components/schemas/ForgotPasswordRequest"
              }
            }
          },
          "required" : true
        },
        "responses" : {
          "200" : {
            "content" : {
              "application/json" : {
                "schema" : {
                  "$ref" : "#/components/schemas/ApiResponseRequestAccepted"
                }
              }
            },
            "description" : "OK"
          },
          "default" : {
            "content" : {
              "application/json" : {
                "schema" : {
                  "$ref" : "#/components/schemas/ApiErrorResponse"
                }
              }
            },
            "description" : "Error. The code says what went wrong; the message is safe to show."
          }
        },
        "summary" : "Ask for a password-reset link",
        "tags" : [ "Authentication" ]
      }
    },
    "/api/v1/auth/password/reset" : {
      "post" : {
        "description" : "Answers 204 and ends every session of the user, on every device; the person signs in again. A link that is unknown, used, replaced or expired is a VALIDATION_ERROR on the field token. A password that breaks the policy is a VALIDATION_ERROR on the field newPassword and leaves the link usable.",
        "operationId" : "completePasswordReset",
        "requestBody" : {
          "content" : {
            "application/json" : {
              "schema" : {
                "$ref" : "#/components/schemas/ResetPasswordRequest"
              }
            }
          },
          "required" : true
        },
        "responses" : {
          "200" : {
            "description" : "OK"
          },
          "default" : {
            "content" : {
              "application/json" : {
                "schema" : {
                  "$ref" : "#/components/schemas/ApiErrorResponse"
                }
              }
            },
            "description" : "Error. The code says what went wrong; the message is safe to show."
          }
        },
        "summary" : "Set a new password with the token from the e-mailed link",
        "tags" : [ "Authentication" ]
      }
    },
    "/api/v1/auth/refresh" : {
      "post" : {
        "description" : "Uses the refresh cookie. Answers 204 with new cookies, or 401 UNAUTHENTICATED with the cookies removed when the refresh token is unknown, expired, revoked or was already used.",
        "operationId" : "refreshSession",
        "responses" : {
          "200" : {
            "description" : "OK"
          },
          "default" : {
            "content" : {
              "application/json" : {
                "schema" : {
                  "$ref" : "#/components/schemas/ApiErrorResponse"
                }
              }
            },
            "description" : "Error. The code says what went wrong; the message is safe to show."
          }
        },
        "summary" : "Replace the session tokens",
        "tags" : [ "Authentication" ]
      }
    },
    "/api/v1/auth/sign-in" : {
      "post" : {
        "description" : "On success answers 204 and sets the short-lived login cookie; the browser then continues with the sign-in page navigation (/api/v1/auth/start) to receive its session cookies. Every kind of failure (unknown address, wrong password, locked, disabled, not yet verified) answers the same 401 UNAUTHENTICATED; too many attempts answer 429 RATE_LIMITED.",
        "operationId" : "signIn",
        "requestBody" : {
          "content" : {
            "application/json" : {
              "schema" : {
                "$ref" : "#/components/schemas/SignInRequest"
              }
            }
          },
          "required" : true
        },
        "responses" : {
          "200" : {
            "description" : "OK"
          },
          "default" : {
            "content" : {
              "application/json" : {
                "schema" : {
                  "$ref" : "#/components/schemas/ApiErrorResponse"
                }
              }
            },
            "description" : "Error. The code says what went wrong; the message is safe to show."
          }
        },
        "summary" : "Check an email address and a password",
        "tags" : [ "Authentication" ]
      }
    },
    "/api/v1/auth/sign-out" : {
      "post" : {
        "description" : "Revokes the tokens the browser presents and removes the cookies. Always answers 204: signing out when not signed in is not an error.",
        "operationId" : "signOut",
        "responses" : {
          "200" : {
            "description" : "OK"
          },
          "default" : {
            "content" : {
              "application/json" : {
                "schema" : {
                  "$ref" : "#/components/schemas/ApiErrorResponse"
                }
              }
            },
            "description" : "Error. The code says what went wrong; the message is safe to show."
          }
        },
        "summary" : "End the current sign-in",
        "tags" : [ "Authentication" ]
      }
    },
    "/api/v1/auth/sign-out-all" : {
      "post" : {
        "description" : "Revokes every session and token of the signed-in user, on every device and instance, at once.",
        "operationId" : "signOutEverywhere",
        "responses" : {
          "200" : {
            "description" : "OK"
          },
          "default" : {
            "content" : {
              "application/json" : {
                "schema" : {
                  "$ref" : "#/components/schemas/ApiErrorResponse"
                }
              }
            },
            "description" : "Error. The code says what went wrong; the message is safe to show."
          }
        },
        "summary" : "End every sign-in of the user",
        "tags" : [ "Authentication" ]
      }
    },
    "/api/v1/auth/sign-up" : {
      "post" : {
        "description" : "Always answers 202 with the same text, whether or not the address already has an account: if it may sign up, an e-mail with a link follows. Only on the platform host. Asking again is the way to have the e-mail sent again; a newer link replaces the older one. Too many requests answer 429 RATE_LIMITED.",
        "operationId" : "requestSignUp",
        "requestBody" : {
          "content" : {
            "application/json" : {
              "schema" : {
                "$ref" : "#/components/schemas/SignUpRequest"
              }
            }
          },
          "required" : true
        },
        "responses" : {
          "200" : {
            "content" : {
              "application/json" : {
                "schema" : {
                  "$ref" : "#/components/schemas/ApiResponseRequestAccepted"
                }
              }
            },
            "description" : "OK"
          },
          "default" : {
            "content" : {
              "application/json" : {
                "schema" : {
                  "$ref" : "#/components/schemas/ApiErrorResponse"
                }
              }
            },
            "description" : "Error. The code says what went wrong; the message is safe to show."
          }
        },
        "summary" : "Start a sign-up with an e-mail address",
        "tags" : [ "Authentication" ]
      }
    },
    "/api/v1/auth/sign-up/complete" : {
      "post" : {
        "description" : "Answers 204 when the account was created; the person then signs in. A link that is unknown, used, replaced or expired is a VALIDATION_ERROR on the field token, always with the same message. A password that breaks the policy is a VALIDATION_ERROR on the field password and leaves the link usable.",
        "operationId" : "completeSignUp",
        "requestBody" : {
          "content" : {
            "application/json" : {
              "schema" : {
                "$ref" : "#/components/schemas/CompleteSignUpRequest"
              }
            }
          },
          "required" : true
        },
        "responses" : {
          "200" : {
            "description" : "OK"
          },
          "default" : {
            "content" : {
              "application/json" : {
                "schema" : {
                  "$ref" : "#/components/schemas/ApiErrorResponse"
                }
              }
            },
            "description" : "Error. The code says what went wrong; the message is safe to show."
          }
        },
        "summary" : "Create the account with the token from the e-mailed link",
        "tags" : [ "Authentication" ]
      }
    },
    "/api/v1/organizations" : {
      "post" : {
        "description" : "The signed-in person creates an organization and becomes its founding administrator. The short name (slug) becomes the first label of the organization's host name. Answers 201 with the host to sign in at. A name or slug that is not acceptable or not free is a VALIDATION_ERROR on its field; a person who already founded as many organizations as allowed is FORBIDDEN. Only on the platform host.",
        "operationId" : "createOrganization",
        "requestBody" : {
          "content" : {
            "application/json" : {
              "schema" : {
                "$ref" : "#/components/schemas/CreateOrganizationRequest"
              }
            }
          },
          "required" : true
        },
        "responses" : {
          "200" : {
            "content" : {
              "application/json" : {
                "schema" : {
                  "$ref" : "#/components/schemas/ApiResponseOrganizationCreated"
                }
              }
            },
            "description" : "OK"
          },
          "default" : {
            "content" : {
              "application/json" : {
                "schema" : {
                  "$ref" : "#/components/schemas/ApiErrorResponse"
                }
              }
            },
            "description" : "Error. The code says what went wrong; the message is safe to show."
          }
        },
        "summary" : "Found an organization",
        "tags" : [ "Organizations" ]
      }
    },
    "/api/v1/platform/status" : {
      "get" : {
        "description" : "Succeeds when the API is running and its database answered a query.",
        "operationId" : "getPlatformStatus",
        "responses" : {
          "200" : {
            "content" : {
              "application/json" : {
                "schema" : {
                  "$ref" : "#/components/schemas/ApiResponsePlatformStatus"
                }
              }
            },
            "description" : "OK"
          },
          "default" : {
            "content" : {
              "application/json" : {
                "schema" : {
                  "$ref" : "#/components/schemas/ApiErrorResponse"
                }
              }
            },
            "description" : "Error. The code says what went wrong; the message is safe to show."
          }
        },
        "summary" : "Platform status",
        "tags" : [ "Platform" ]
      }
    },
    "/api/v1/tenant/current" : {
      "get" : {
        "description" : "Answers with the organization the request's host name addresses. A host that addresses no organization, or an unknown one, is NOT_FOUND; a suspended, deactivated or not yet open one is TENANT_UNAVAILABLE. The organization can never be chosen by a header, parameter or body.",
        "operationId" : "getCurrentTenant",
        "responses" : {
          "200" : {
            "content" : {
              "application/json" : {
                "schema" : {
                  "$ref" : "#/components/schemas/ApiResponseTenantSummary"
                }
              }
            },
            "description" : "OK"
          },
          "default" : {
            "content" : {
              "application/json" : {
                "schema" : {
                  "$ref" : "#/components/schemas/ApiErrorResponse"
                }
              }
            },
            "description" : "Error. The code says what went wrong; the message is safe to show."
          }
        },
        "summary" : "The organization of this host name",
        "tags" : [ "Tenant" ]
      }
    }
  },
  "components" : {
    "schemas" : {
      "ApiError" : {
        "type" : "object",
        "properties" : {
          "code" : {
            "$ref" : "#/components/schemas/ErrorCode"
          },
          "fields" : {
            "type" : "object",
            "additionalProperties" : {
              "type" : "array",
              "items" : {
                "type" : "string"
              }
            }
          },
          "message" : {
            "type" : "string"
          },
          "requestId" : {
            "type" : "string"
          },
          "traceId" : {
            "type" : "string"
          }
        },
        "required" : [ "code", "message", "requestId" ]
      },
      "ApiErrorResponse" : {
        "type" : "object",
        "properties" : {
          "error" : {
            "$ref" : "#/components/schemas/ApiError"
          }
        },
        "required" : [ "error" ]
      },
      "ApiResponseCurrentUser" : {
        "type" : "object",
        "properties" : {
          "data" : {
            "$ref" : "#/components/schemas/CurrentUser"
          }
        },
        "required" : [ "data" ]
      },
      "ApiResponseOrganizationCreated" : {
        "type" : "object",
        "properties" : {
          "data" : {
            "$ref" : "#/components/schemas/OrganizationCreated"
          }
        },
        "required" : [ "data" ]
      },
      "ApiResponsePlatformStatus" : {
        "type" : "object",
        "properties" : {
          "data" : {
            "$ref" : "#/components/schemas/PlatformStatus"
          }
        },
        "required" : [ "data" ]
      },
      "ApiResponseRequestAccepted" : {
        "type" : "object",
        "properties" : {
          "data" : {
            "$ref" : "#/components/schemas/RequestAccepted"
          }
        },
        "required" : [ "data" ]
      },
      "ApiResponseTenantSummary" : {
        "type" : "object",
        "properties" : {
          "data" : {
            "$ref" : "#/components/schemas/TenantSummary"
          }
        },
        "required" : [ "data" ]
      },
      "ChangePasswordRequest" : {
        "type" : "object",
        "properties" : {
          "currentPassword" : {
            "type" : "string",
            "maxLength" : 1024,
            "minLength" : 0
          },
          "newPassword" : {
            "type" : "string",
            "maxLength" : 1024,
            "minLength" : 0
          }
        },
        "required" : [ "currentPassword", "newPassword" ]
      },
      "CompleteSignUpRequest" : {
        "type" : "object",
        "properties" : {
          "displayName" : {
            "type" : "string",
            "maxLength" : 200,
            "minLength" : 0
          },
          "password" : {
            "type" : "string",
            "maxLength" : 1024,
            "minLength" : 0
          },
          "token" : {
            "type" : "string",
            "maxLength" : 200,
            "minLength" : 0
          }
        },
        "required" : [ "displayName", "password", "token" ]
      },
      "CreateOrganizationRequest" : {
        "type" : "object",
        "properties" : {
          "displayName" : {
            "type" : "string",
            "maxLength" : 200,
            "minLength" : 0
          },
          "slug" : {
            "type" : "string",
            "maxLength" : 100,
            "minLength" : 0
          }
        },
        "required" : [ "displayName", "slug" ]
      },
      "CurrentUser" : {
        "type" : "object",
        "properties" : {
          "displayName" : {
            "type" : "string"
          },
          "email" : {
            "type" : "string"
          },
          "id" : {
            "type" : "string"
          }
        },
        "required" : [ "displayName", "email", "id" ]
      },
      "ErrorCode" : {
        "type" : "string",
        "description" : "Stable machine-readable error code. Branch on this, never on the message.",
        "enum" : [ "VALIDATION_ERROR", "MALFORMED_REQUEST", "UNAUTHENTICATED", "FORBIDDEN", "NOT_FOUND", "METHOD_NOT_ALLOWED", "NOT_ACCEPTABLE", "CONFLICT", "CONCURRENT_MODIFICATION", "PAYLOAD_TOO_LARGE", "UNSUPPORTED_MEDIA_TYPE", "RATE_LIMITED", "INTERNAL_ERROR", "SERVICE_UNAVAILABLE", "TENANT_UNAVAILABLE" ]
      },
      "ForgotPasswordRequest" : {
        "type" : "object",
        "properties" : {
          "email" : {
            "type" : "string",
            "maxLength" : 320,
            "minLength" : 0
          }
        },
        "required" : [ "email" ]
      },
      "OrganizationCreated" : {
        "type" : "object",
        "properties" : {
          "displayName" : {
            "type" : "string"
          },
          "host" : {
            "type" : "string"
          },
          "slug" : {
            "type" : "string"
          }
        },
        "required" : [ "displayName", "host", "slug" ]
      },
      "Pagination" : {
        "type" : "object",
        "properties" : {
          "hasMore" : {
            "type" : "boolean"
          },
          "limit" : {
            "type" : "integer",
            "format" : "int32"
          },
          "nextCursor" : {
            "type" : "string"
          }
        },
        "required" : [ "hasMore", "limit" ]
      },
      "PlatformStatus" : {
        "type" : "object",
        "properties" : {
          "apiVersion" : {
            "type" : "string"
          },
          "databaseTime" : {
            "type" : "string",
            "format" : "date-time"
          },
          "serverTime" : {
            "type" : "string",
            "format" : "date-time"
          },
          "service" : {
            "type" : "string"
          }
        },
        "required" : [ "apiVersion", "databaseTime", "serverTime", "service" ]
      },
      "RequestAccepted" : {
        "type" : "object",
        "properties" : {
          "message" : {
            "type" : "string"
          }
        },
        "required" : [ "message" ]
      },
      "ResetPasswordRequest" : {
        "type" : "object",
        "properties" : {
          "newPassword" : {
            "type" : "string",
            "maxLength" : 1024,
            "minLength" : 0
          },
          "token" : {
            "type" : "string",
            "maxLength" : 200,
            "minLength" : 0
          }
        },
        "required" : [ "newPassword", "token" ]
      },
      "SignInRequest" : {
        "type" : "object",
        "properties" : {
          "email" : {
            "type" : "string",
            "maxLength" : 320,
            "minLength" : 0
          },
          "password" : {
            "type" : "string",
            "maxLength" : 1024,
            "minLength" : 0
          }
        },
        "required" : [ "email", "password" ]
      },
      "SignUpRequest" : {
        "type" : "object",
        "properties" : {
          "email" : {
            "type" : "string",
            "maxLength" : 320,
            "minLength" : 0
          }
        },
        "required" : [ "email" ]
      },
      "TenantSummary" : {
        "type" : "object",
        "properties" : {
          "displayName" : {
            "type" : "string"
          },
          "slug" : {
            "type" : "string"
          }
        },
        "required" : [ "displayName", "slug" ]
      }
    }
  }
}
