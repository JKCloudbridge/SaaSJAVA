                  "$ref" : "#/components/schemas/ApiErrorResponse"
                }
              }
            },
            "description" : "Error. The code says what went wrong; the message is safe to show."
          }
        },
        "summary" : "Receive the forgery-protection cookie",
        "tags" : [ "Authentication" ]
      }
    },
