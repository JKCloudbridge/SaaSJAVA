# The secret store entries of one environment (Sprint 33, ADR-0290): NAMES AND PERMISSIONS ONLY. No value of any secret is in
# any file of this repository; the owner puts each value into the store with the commands of the manual steps, and the
# container service reads them at start. The one exception is the cache password, which is generated (never typed) and goes
# straight into the store.
#
# A task that names a secret with no value does not start, so a forgotten value is a failed start and not a silent default.

locals {
  prefix = "platform/${var.environment}"

  # What the owner fills in (see "Sprint 33 manual steps"). The signing keys have two slots (a and b) so that a key can be
  # replaced while the old one still verifies (runbooks/signing-key-rotation.md); the key of the secrets store has an active
  # and a previous value for the same reason (runbooks/kek-rotation.md).
  entries = toset([
    "db-app-password",
    "smtp-user",
    "smtp-password",
    "kek-active",
    "kek-previous",
    "signing-a-private",
    "signing-a-public",
    "signing-b-private",
    "signing-b-public",
    "cache-password",
  ])
}

resource "aws_secretsmanager_secret" "entry" {
  for_each = local.entries

  name                    = "${local.prefix}/${each.key}"
  description             = "Platform ${var.environment}: ${each.key}. The value is set by the owner, never by these files."
  recovery_window_in_days = var.recovery_window_days
}

# The one value these files produce: the cache password, generated by the data module.
resource "aws_secretsmanager_secret_version" "cache_password" {
  secret_id     = aws_secretsmanager_secret.entry["cache-password"].id
  secret_string = var.cache_password
}
